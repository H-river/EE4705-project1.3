diff --git a/tests/test_b_prompt_diet.py b/tests/test_b_prompt_diet.py
new file mode 100644
index 0000000..1dc83c4
--- /dev/null
+++ b/tests/test_b_prompt_diet.py
@@ -0,0 +1,42 @@
+"""Final2 6.4: B's planning input carries only decision fields, <= 8 instances."""
+import json
+
+from core.types import ExecutionContext, GroundedObject, GroundStatus, SceneDescription
+from planner.prompts import MAX_INSTANCES, planning_input
+
+
+def scene(n_extra):
+    objs = [GroundedObject("s1", "stone", GroundStatus.LOCALIZED, bbox_xyxy=(1, 2, 3, 4), pos_world=(0.41234, -0.1, 0.875),
+                           attributes={"color": "gray"}, confidence=0.9, frame_id=3)]
+    objs += [GroundedObject(f"c{i}", "cube", GroundStatus.LOCALIZED, pos_world=(0.4, 0.1 * i, 0.875),
+                            attributes={"color": "blue"}, frame_id=3) for i in range(n_extra)]
+    region = GroundedObject("r1", "red_region", GroundStatus.LOCALIZED, kind="region", pos_world=(0.4, 0.3, 0.853),
+                            region_half_extents_xy=(0.08, 0.08), frame_id=3)
+    return SceneDescription(objs, [region], "caption", [], frame_id=3)
+
+
+def test_only_decision_fields_and_no_schema_copy():
+    s = scene(1)
+    data = planning_input("Move the stone to the red area.", s, [], ExecutionContext(s), None, None)
+    assert "output_schema" not in data
+    stone = data["scene"]["instances"][0]
+    assert set(stone) == {"instance_id", "name", "kind", "status", "pos_world", "attributes", "color_words"}
+    assert stone["pos_world"] == [0.412, -0.1, 0.875]
+    assert data["scene"]["frame_id"] == 3
+
+
+def test_at_most_eight_instances_goal_and_named_classes_first():
+    s = scene(12)
+    data = planning_input("Move the stone to the red area.", s, [], ExecutionContext(s), None, None)
+    ids = [i["instance_id"] for i in data["scene"]["instances"]]
+    assert len(ids) == MAX_INSTANCES == 8 and ids[:2] == ["s1", "r1"]
+    assert sum(len(g["instance_ids"]) for g in data["candidate_groups"]) == 8
+    goal = {"object_id": "c11", "region_id": "r1"}
+    data = planning_input("Move the stone to the red area.", s, [], ExecutionContext(s), goal, None)
+    assert "c11" in [i["instance_id"] for i in data["scene"]["instances"]]
+
+
+def test_input_is_smaller():
+    s = scene(2)
+    data = planning_input("Move the stone to the red area.", s, [], ExecutionContext(s), None, None)
+    assert len(json.dumps(data)) < 2600
